NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Yalnizca sunucu tarafindaki admin/worker RPC'leri icin. NEXT_PUBLIC_ kullanmayin.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Yerel/Electron gorsel dogrulama render kok dizini (istege bagli).
# Varsayilan: kardes icmal-veri deposundaki storage/rendered.
# Eski KAMU_POZ_RENDERED_ROOT degeri gecis uyumlulugu icin desteklenir.
ICMAL_RENDERED_ROOT=C:\path\to\icmal\icmal-veri\storage\rendered

# Electron production builds load the hosted web application.
EKAP_WEB_URL=https://your-domain.example

# Optional local diagnostics. Never put Supabase secret keys in this repository.
DEBUG=false

# --- Cloudflare R2 (hesap projelerinin icerigi) ---------------------------
# K-04 karma saklama: meta veri ve aranabilir ozet Postgres'te, tam proje
# icerigi burada. R2'ye yazilan nesne yerel .icmal ZIP'i ile BIREBIR aynidir.
#
# Bu degerler YALNIZ sunucu tarafindadir. NEXT_PUBLIC_ ONEKI KULLANMAYIN:
# o onekli her degisken tarayiciya gonderilir ve gizli anahtar sizar.
#
# Belirtec yalniz bu bucket ile sinirli olmali; hesap genelinde yetki vermeyin.
# Bucket herkese acik okumaya KAPALI kalmali; dosyalar imzali URL ile sunulur.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_BUCKET=icmal-projeler
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
# Istege bagli. Bos birakilirsa https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# kullanilir. AB yargi bolgesindeki bucket'lar icin farkli olabilir, o zaman doldurun.
R2_ENDPOINT=
